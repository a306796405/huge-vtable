{
  "name": "pattern-vtable-v22-lite-readonly-rendering",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.5",
  "main": "./dist/extension/extension.js",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onCustomEditor:patternEditorLite.patEditor"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "patternEditorLite.patEditor",
        "displayName": "Pattern Editor Lite (.pat)",
        "selector": [
          {
            "filenamePattern": "*.pat"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:webview": "tsc --noEmit -p tsconfig.webview.json && vite build",
    "build:extension": "tsc -p tsconfig.extension.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm build:webview && pnpm build:extension && pnpm test"
  },
  "dependencies": {
    "@visactor/react-vtable": "1.22.2",
    "@visactor/vtable": "1.22.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/vscode": "1.125.0",
    "typescript": "5.8.3",
    "vite": "5.4.19",
    "vitest": "2.1.9"
  }
}
